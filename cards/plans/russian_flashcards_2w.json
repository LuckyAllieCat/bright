        {
          "id": "ru-009",
          "day": 1,
          "type": "vocab",
          "front": "До свида́ния!",
          "back": "Goodbye! (formal)"
        },
        {
          "id": "ru-010",
          "day": 1,
          "type": "rule",
          "front": "ты or вы?",
          "back": "ты = one person you know well; вы = formal, or more than one person"
        },
        {
          "id": "ru-011",
          "day": 2,
          "type": "vocab",
          "front": "здесь",
          "back": "here"
        },
        {
          "id": "ru-012",
          "day": 2,
          "type": "vocab",
          "front": "там",
          "back": "there"
        },
        {
          "id": "ru-013",
          "day": 2,
          "type": "vocab",
          "front": "где",
          "back": "where"
        },
        {
          "id": "ru-014",
          "day": 2,
          "type": "vocab",
          "front": "вот",
          "back": "here is / there is (pointing)"
        },
        {
          "id": "ru-015",
          "day": 2,
          "type": "rule",
          "front": "Where is the word for 'is'?",
          "back": "There isn't one in the present: Ма́ма здесь. = Mum is here."
        },
        {
          "id": "ru-016",
          "day": 2,
          "type": "sentence",
          "front": "Where's mum? — Mum is here.",
          "back": "Где ма́ма? — Ма́ма здесь."
        },
        {
          "id": "ru-017",
          "day": 2,
          "type": "sentence",
          "front": "Where's the metro? — The metro is over there.",
          "back": "Где метро́? — Метро́ там."
        },
        {
          "id": "ru-018",
          "day": 2,
          "type": "sentence",
          "front": "Where are you? — I'm here.",
          "back": "Где ты? — Я здесь."
        },
        {
          "id": "ru-019",
          "day": 2,
          "type": "sentence",
          "front": "Here's the house.",
          "back": "Вот дом."
        },
        {
          "id": "ru-020",
          "day": 3,
          "type": "rule",
          "front": "Hard and soft vowel pairs",
          "back": "а – я, э – е, ы – и, о – ё, у – ю"
        },
        {
          "id": "ru-021",
          "day": 3,
          "type": "rule",
          "front": "How does unstressed о sound?",
          "back": "Like а: молоко́, хорошо́. о sounds like о only when stressed"
        },
        {
          "id": "ru-022",
          "day": 3,
          "type": "rule",
          "front": "Why does ё never get a stress mark?",
          "back": "ё is always stressed: всё, ещё"
        },
        {
          "id": "ru-023",
          "day": 3,
          "type": "rule",
          "front": "What does ь do?",
          "back": "It softens the consonant before it: мать, день"
        },
        {
          "id": "ru-024",
          "day": 3,
          "type": "vocab",
          "front": "молоко́",
          "back": "milk"
        },
        {
          "id": "ru-025",
          "day": 3,
          "type": "vocab",
          "front": "вода́",
          "back": "water"
        },
        {
          "id": "ru-026",
          "day": 3,
          "type": "vocab",
          "front": "До за́втра!",
          "back": "See you tomorrow!"
        },
        {
          "id": "ru-027",
          "day": 3,
          "type": "vocab",
          "front": "До встре́чи!",
          "back": "See you! (lit. until we meet)"
        }
      ]
    },
