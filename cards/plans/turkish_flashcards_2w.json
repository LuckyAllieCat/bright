      "deck": "Türkçe::01 Consonant alternation",
      "topic": "Consonant alternation: softening & hardening",
      "source": "Udemy 6–7 · Consonant Alternation 1–2",
      "tags": [
        "türkçe",
        "plan-2w"
      ],
      "cards": [
        {
          "id": "tr-001",
          "day": 1,
          "type": "rule",
          "front": "Softening: which consonants change before a vowel suffix?",
          "back": "p → b, ç → c, t → d, k → ğ (nk → ng)"
        },
        {
          "id": "tr-002",
          "day": 1,
          "type": "form",
          "front": "kitap + -ı",
          "back": "kitabı"
        },
        {
          "id": "tr-003",
          "day": 1,
          "type": "form",
          "front": "ağaç + -ı",
          "back": "ağacı",
          "note": "ağaç = tree"
        },
        {
          "id": "tr-004",
          "day": 1,
          "type": "form",
          "front": "kâğıt + -ı",
          "back": "kâğıdı",
          "note": "kâğıt = paper; often written kağıt"
        },
        {
          "id": "tr-005",
          "day": 1,
          "type": "form",
          "front": "çocuk + -u",
          "back": "çocuğu"
        },
        {
          "id": "tr-006",
          "day": 1,
          "type": "form",
          "front": "renk + -i",
          "back": "rengi",
          "note": "nk → ng; one of the few one-syllable words that changes"
